#!/bin/zsh
# cc - remote dev server session manager
#   cc                Attach to 'main' session (or create it)
#   cc <name>         Attach to named session (or create it)
#   cc ls             List all tmux sessions on the server
#   cc kill <name>    Kill a specific session
#   cc -h             Show this help

SSH_HOST="cc"

usage() {
  cat <<EOF
cc - remote dev server session manager

Usage:
  cc                Attach to 'main' session (or create it)
  cc <name>         Attach to named session (or create it)
  cc ls             List all tmux sessions on the server
  cc kill <name>    Kill a specific session
  cc -h             Show this help
EOF
}

case "$1" in
  -h|--help)
    usage
    ;;
  ls)
    ssh "$SSH_HOST" "tmux list-sessions 2>/dev/null || echo 'No active sessions'"
    ;;
  kill)
    if [[ -z "$2" ]]; then
      echo "Usage: cc kill <session>"
      exit 1
    fi
    ssh "$SSH_HOST" "tmux kill-session -t '$2'"
    ;;
  *)
    local session="${1:-main}"
    # Keep the forwarded TERM when the server has that terminfo entry (the
    # image ships xterm-ghostty), fall back only for clients it doesn't know.
    # COLORTERM is never forwarded by ssh, so set it for truecolor apps.
    ssh -t "$SSH_HOST" "infocmp \$TERM >/dev/null 2>&1 || export TERM=xterm-256color; \
      COLORTERM=truecolor tmux new-session -A -s '$session'"
    ;;
esac
