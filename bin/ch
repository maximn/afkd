#!/bin/zsh
# ch - remote herdr session manager (runs locally, attaches over ssh)
#   ch                Attach to the default herdr session
#   ch <name>         Attach to named session (or create it)
#   ch ls             List all herdr sessions on the server
#   ch kill <name>    Stop a specific session
#   ch -h             Show this help
#
# The tmux counterpart is `cc`. Both target the same box; attach to one
# multiplexer or the other, never one inside the other.

SSH_HOST="cc"

# Keep the forwarded TERM when the server has that terminfo entry (the image
# ships xterm-ghostty), fall back only for clients it doesn't know. COLORTERM
# is never forwarded by ssh, so set it for truecolor apps.
TERM_FIX='infocmp $TERM >/dev/null 2>&1 || export TERM=xterm-256color; export COLORTERM=truecolor;'

usage() {
  cat <<EOF
ch - remote herdr session manager

Usage:
  ch                Attach to the default herdr session
  ch <name>         Attach to named session (or create it)
  ch ls             List all herdr sessions on the server
  ch kill <name>    Stop a specific session
  ch -h             Show this help
EOF
}

case "$1" in
  -h|--help)
    usage
    ;;
  ls)
    ssh "$SSH_HOST" "herdr session list"
    ;;
  kill)
    if [[ -z "$2" ]]; then
      echo "Usage: ch kill <session>"
      exit 1
    fi
    ssh "$SSH_HOST" "herdr session stop '$2'"
    ;;
  *)
    if [[ -z "$1" ]]; then
      ssh -t "$SSH_HOST" "$TERM_FIX herdr"
    else
      ssh -t "$SSH_HOST" "$TERM_FIX herdr --session '$1'"
    fi
    ;;
esac
