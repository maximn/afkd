#!/bin/zsh
# t - tmux session manager (server-side)
#   t               → attach/create session "main"
#   t <name>        → attach/create session "<name>"
#   t ls            → list sessions
#   t kill <name>   → kill session
#   t -l            → list sessions (compat)
#   t -k <name>     → kill session (compat)

case "$1" in
  -l|--list|ls)
    tmux list-sessions 2>/dev/null || echo "No active sessions"
    ;;
  -k|--kill|kill)
    if [[ -z "$2" ]]; then
      echo "Usage: t kill <session>"
      exit 1
    fi
    tmux kill-session -t "$2"
    ;;
  *)
    local session="${1:-main}"
    exec tmux new-session -A -s "$session"
    ;;
esac
