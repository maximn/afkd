#!/bin/zsh
# h - herdr session manager (server-side)
#   h               → attach to the default herdr session
#   h <name>        → attach to named session "<name>"
#   h ls            → list sessions
#   h kill <name>   → stop session "<name>"

# herdr refuses nested launches, and running it under tmux leaves two
# multiplexers fighting over the same PTY. Fail with an explanation
# rather than herdr's own error.
if [[ -n "$HERDR_ENV" ]]; then
  echo "Already inside a herdr pane. Use the sidebar or 'herdr workspace create'."
  exit 1
fi
if [[ -n "$TMUX" ]]; then
  echo "Inside tmux. Detach first (ctrl+b d), then run 'h' from a clean shell."
  exit 1
fi

case "$1" in
  -l|--list|ls)
    herdr session list
    ;;
  -k|--kill|kill)
    if [[ -z "$2" ]]; then
      echo "Usage: h kill <session>"
      exit 1
    fi
    herdr session stop "$2"
    ;;
  *)
    if [[ -z "$1" ]]; then
      exec herdr
    else
      exec herdr --session "$1"
    fi
    ;;
esac
