# Every variable the image reads. Copy to .env and fill in what you need;
# .gitignore keeps that copy out of git and .dockerignore keeps it out of the
# build context. Nothing here is baked into the image.
#
# Optional variables are left commented out on purpose: an uncommented
# placeholder is worse than an unset variable, because the feature switches on
# and then fails against a value nobody meant.

# --- Required ----------------------------------------------------------------

# One SSH public key per line. The entrypoint refuses to boot without this:
# password auth is disabled, so no keys would mean a container that passes its
# healthcheck while being impossible to log into.
#
# The value is multiline, which a host's environment UI (Coolify's, for one)
# handles but `docker run --env-file` does not -- pass it with -e there.
SSH_PUBLIC_KEYS=ssh-ed25519 AAAA...key1
ssh-ed25519 AAAA...key2

# --- Git identity -------------------------------------------------------------

# No default. Leave these unset and git refuses to commit on the box until you
# set them by hand, which is the intended failure: a default would put someone
# else's name on your commits.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# --- GitHub --------------------------------------------------------------------

# Used by `gh` and by the agents for anything that goes through the API.
#GH_TOKEN=ghp_...

# Private SSH key for git-over-SSH, as either a raw PEM key or base64
# (`base64 < ~/.ssh/remote-claude | tr -d '\n'`) -- the entrypoint detects
# which. Worth setting alongside GH_TOKEN because some orgs cap fine-grained
# PAT lifetimes, so a token alone cannot clone their repos. Add the matching
# public key at https://github.com/settings/ssh/new
#GITHUB_SSH_KEY=

# --- Agent credentials ----------------------------------------------------------

# Only needed if you authenticate by API key. `claude login` and `codex login`
# store their credentials in the mounted volumes instead, which survives a
# redeploy and is the usual route.
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...

# Any CLAUDE_* or CODEX_* variable is forwarded to SSH sessions as well, so
# agent settings can be set here rather than on the box. For example:
#CLAUDE_CODE_USE_BEDROCK=1
#CODEX_HOME=/root/.codex

# --- Notifications (optional) -----------------------------------------------------

# Claude Code hooks that push to ntfy when the agent needs input or finishes a
# turn. This is what lets a detached session page a phone instead of needing
# someone attached. Unset means no hooks are written at all.
#NTFY_URL=https://ntfy.example.com/claude
#NTFY_TOKEN=tk_...
